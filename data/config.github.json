        "limit": 7,
        "categories": ["运动科学"]
      },
      "营养学": {
        "limit": 7,
        "categories": ["营养学"]
      },
      "热点趋势": {
        "limit": 6,
        "categories": ["热点趋势", "news"]
      }
    },
